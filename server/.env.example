PORT=5001
# Local MongoDB, or your Atlas string (mongodb+srv://user:password@cluster.../granddquiz). MONGO_URI also works.
MONGODB_URI=mongodb://127.0.0.1:27017/granddquiz
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated browser origins allowed to call the API and sockets (empty = allow all, dev only)
CLIENT_ORIGIN=http://localhost:5173

# First deploy: these create the admin account if it does not exist yet (used by the seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Quiz Admin

# Fill the question bank automatically on boot when it is empty (default: true)
AUTO_SEED=true
# Quiz masters can sign themselves up (default true). Free accounts are capped at 10 players. Set false to invite only.
ALLOW_HOST_SIGNUP=true
# Finished-event results and registrations are auto-deleted after this many days
RETENTION_DAYS=30
MAX_TEAM_SIZE=10

# ---- Payments with Flutterwave (leave FLW_SECRET_KEY empty to switch online payment off; see BILLING.md)
FLW_SECRET_KEY=
FLW_SECRET_HASH=
BILLING_CURRENCY=ZMW
# Public address of this API, and of your Firebase site (where people land after paying)
API_PUBLIC_URL=https://granddquizzes.onrender.com
CLIENT_PUBLIC_URL=https://granddquiz.web.app
# Optional: change prices without code. JSON, in the billing currency
# PLAN_PRICES={"event_small":150,"event_medium":400,"event_large":900,"venue_month":600,"venue_year":6000,"pro_month":1500}

# ---- Email (optional) via Brevo. Alerts you to new contact messages and quiz master requests, and tells quiz masters when approved.
# Put the real values only in server/.env and in Render's Environment tab, never in the code.
# BREVO_API_KEY works on Render's free plan (it uses HTTPS). SMTP_* is the fallback and may be blocked on free hosting.
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Granddquiz <hello@fugipay.com>
# Where alerts go (defaults to ADMIN_EMAIL)
NOTIFY_EMAIL=
