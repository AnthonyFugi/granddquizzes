PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/granddquiz
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated browser origins allowed to call the API and sockets (empty = allow all, dev only)
CLIENT_ORIGIN=http://localhost:5173

# First deploy: these create the admin account if it does not exist yet (used by the seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Quiz Admin

# Fill the question bank automatically on boot when it is empty (default: true)
AUTO_SEED=true
# Let people self-register as quiz masters (default false: an admin creates them)
ALLOW_HOST_SIGNUP=false
# Finished-event results and registrations are auto-deleted after this many days
RETENTION_DAYS=30
MAX_TEAM_SIZE=10
